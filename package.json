{
  "name": "hmt-mobile",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run webpack && npm run copyfiles",
    "webpack": "webpack --config webpack.config.js",
    "webpack:watch": "webpack --config webpack.config.js --watch",
    "copyfiles": "copyfiles -u 1 views/**/* dist/views && copyfiles -u 1 public/* public/**/* dist/public",
    "copyfiles:watch": "chokidar \"views/**/*\" \"public/**/*\" -c \"npm run copyfiles\"",
    "watch": "concurrently \"npm run webpack:watch\" \"npm run copyfiles:watch\"",
    "start": "node dist/server.js",
    "dev": "concurrently \"npm run watch\" \"npm run start\""
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@types/express": "^5.0.0",
    "babel-loader": "^9.1.3",
    "chokidar": "^4.0.1",
    "concurrently": "^9.1.0",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "fs": "^0.0.1-security",
    "hls.js": "^1.5.11",
    "mathjs": "^13.0.0",
    "munkres": "^2.0.4",
    "opencv-ts": "^1.3.6",
    "ts-loader": "^9.5.1",
    "ulid": "^2.3.0",
    "video.js": "^8.12.0",
    "webpack": "^5.93.0"
  },
  "devDependencies": {
    "webextension-polyfill": "^0.12.0",
    "webpack-cli": "^5.1.4"
  }
}
