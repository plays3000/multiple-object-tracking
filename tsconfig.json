{
  "compilerOptions": {
    "target": "ES2022", // 최신 ECMAScript 타겟으로 설정
    "module": "ESNext", // ESM 모듈 시스템 사용
    "lib": ["ESNext", "dom"],
    "allowJs": true,
    "moduleResolution": "node",
    "esModuleInterop": true, // CommonJS 모듈과 호환성을 위해 설정
    "skipLibCheck": true, // 라이브러리 검사를 건너뜀 (빌드 속도 향상)
    "forceConsistentCasingInFileNames": true, // 파일 이름 대소문자 일관성 검사
    "strict": true, // 엄격한 타입 검사
    "outDir": "./dist", // 컴파일된 파일이 위치할 디렉토리
    "rootDir": "./src", // 소스 파일이 위치한 디렉토리
    "resolveJsonModule": true, // JSON 모듈을 import 할 수 있게 설정
    "isolatedModules": true, // 개별 모듈 처리 (빠른 재컴파일을 위해)
    "noEmitOnError": true, // 오류 발생 시 컴파일을 중단
    "paths": {
      "@config": ["./config.json"]
    }
  },
  "ts-node": {
    "esm": true
  },
  "include": [
    "./src/**/*.ts",
    "src/index.ts",
    "types.d.ts",
    "src/util/util.ㅅㄴ"
  ], // 컴파일 대상 파일 지정
  "exclude": ["node_modules"] // 제외할 파일 지정
}
