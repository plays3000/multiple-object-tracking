{
  "modelOptions": {
    "modelPath": "./model-f16/mb3-centernet.json",
    "outputTensors": "['tower_0/detections']",
    "minScore": 0.4,
    "iouThreshold": 0.2,
    "maxResults": 15
  },
  "faceOptions": {
    "modelPath": "./mb3-f32-480x640/dbface.json",
    "minScore": 0.6,
    "iouThreshold": 0.1,
    "maxResults": 20
  },

  "featureOptions": {
    "modelPath": "./SiameseNet_feature_extractor_tfjs/model.json"
  },
  "movenetOptions": {
    "modelPath": "./movenet_multipose/model.json"
  },
  "positionOptions": {
    "modelPath": "./position_tfjs/model.json"
  },
  "tyyNetOptions": {
    "modelPath": "./TYY_Net_tfjs_2/model.json"
  },

  "backend": "webgpu",
  "threshold": 0.4,
  "camType": "webcam",
  "fps": 5,
  "imgInputShape": [640, 480],
  "reshape": 512,
  "preprocessSwitch": false,
  "renderSwitch": true,
  "isSendingData": false,
  "indexedDBFilter": "month",
  "commonRetentionPeriod": 1,
  "indexSwitch": false,
  "serverUrl": "https://api-dev.meerzet.com",
  "rtcServerUrl": "http://localhost:8002",
  "client": { "debug": true }
}
